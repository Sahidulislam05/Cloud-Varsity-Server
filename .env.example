# Core server settings.
# NODE_ENV: "development" or "production" (drives cookie flags, CORS, error verbosity).
NODE_ENV=development
PORT=5000

# PostgreSQL (Neon) connection string. Required to boot.
DATABASE_URL="my neon database url"

# JWT signing secrets. Generate each with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# MUST be different values; rotating them invalidates all issued tokens.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access token lifetime (short-lived, e.g. 15m). Refresh token lifetime (long-lived, e.g. 7d).
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt cost factor used when hashing passwords (10 is a sane default).
BCRYPT_SALT_ROUNDS=10

# Used to build absolute links back to this API (payment gateway callbacks, etc.).
BACKEND_URL=http://localhost:5000

# Allowed CORS origins for the browser client, comma-separated.
FRONTEND_URL=http://localhost:3000

# Optional: Google OAuth client id (enables Google sign-in). Warn-only if missing.
GOOGLE_CLIENT_ID=

# Optional: "true" enables POST /auth/demo-login, which signs anyone in as the
# seeded accounts below (Super Admin included) without a password. Use only
# for a public demo deployment with throwaway data. Defaults to "false".
DEMO_MODE=false

# # Seeding roles:
# 1. STUDENT
# 2. INSTRUCTOR
# 3. DEPARTMENT_ADMIN
# 4. REGISTRAR
# 5. FINANCE_ADMIN
# 6. SUPER_ADMIN

# Initial seed accounts created on first boot. All are required.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=


INSTRUCTOR_ADMIN_NAME=
INSTRUCTOR_ADMIN_EMAIL=
INSTRUCTOR_ADMIN_PASSWORD=


DEPARTMENT_ADMIN_NAME=
DEPARTMENT_ADMIN_EMAIL=
DEPARTMENT_ADMIN_PASSWORD=


REGISTRAR_NAME=
REGISTRAR_EMAIL=
REGISTRAR_PASSWORD=

FINANCE_ADMIN_NAME=
FINANCE_ADMIN_EMAIL=
FINANCE_ADMIN_PASSWORD=


STUDENT_NAME=
STUDENT_EMAIL=
STUDENT_PASSWORD=


# Optional: Redis (OTP storage, token revocation, dashboard cache).
# The app boots without it, but password reset and refresh-token revocation
# require it, so configure it in production.
REDIS_USER=default
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=13528

# SMTP credentials for transactional email (OTP, welcome, notifications). Required.
SMTP_USER=YOUR_GOOGLE_APP_PASSWORD_EMAIL
EMAIL_SENDER=YOUR_GOOGLE_APP_PASSWORD_EMAIL
SMTP_PASSWORD=

# SSLCommerz payment gateway credentials. Required for the payment module.
SSL_COMMERZ_STORE_ID=my_store_id
SSL_COMMERZ_STORE_PASSWORD=my_store_password
SSL_COMMERZ_IS_LIVE=false
